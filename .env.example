# Pulsync self-hosted server — environment variables
# All values are optional. With none set, the server runs fully self-contained:
# SQLite database + in-process MQTT broker, no external services.

# HTTP port (dashboard + device API). Default 3456.
PORT=3456

# Database: leave DATABASE_URL unset to use a local SQLite file (default).
# Set it to a postgresql:// URL to use PostgreSQL instead.
# DATABASE_URL=postgresql://user:pass@localhost:5432/pulsync
# SQLITE_PATH=./pulsync.db

# Embedded MQTT broker port. Default 1883.
# MQTT_PORT=1883

# Optional single-password gate for the dashboard + management routes.
# Empty = open (fine for a trusted LAN).
# ADMIN_PASSWORD=

# Signs admin session cookies. Set a stable value to keep sessions across restarts.
# JWT_SECRET=change-me

# mDNS: advertise the server as "<hostname>.local" on the LAN so devices find it
# by name. Default on. Set MDNS_ENABLE=false to disable; MDNS_HOSTNAME to rename.
# MDNS_ENABLE=true
# MDNS_HOSTNAME=pulsync

# OTA firmware storage directory.
# OTA_STORAGE_PATH=./storage/firmware
